// Bind _WindowStart, _WindowEnd, _QueryNow and _TrafficType before this query.
// Source: voice-agent-portal-logs / ContainerAppConsoleLogs_CL.
// _TrafficType: customer (default), synthetic, or all. UTC windows are half-open.
let Raw = materialize(
    ContainerAppConsoleLogs_CL
    | where TimeGenerated >= _QueryNow - 30d and TimeGenerated <= _QueryNow
    | where ContainerAppName_s == "voice-agent-playground"
    | where Log_s contains "PLAYGROUND_USAGE "
    | extend data = parse_json(extract(@"PLAYGROUND_USAGE (\{.*\})", 1, Log_s)),
        ingested_at = ingestion_time()
    | extend event_id = tostring(data.event_id),
        occurred_at = todatetime(data.occurred_at),
        event_name = tostring(data.event_name),
        schema_version = toint(data.schema_version),
        user_id = tostring(data.user_id), traffic_type = tostring(data.traffic_type),
        outcome = tostring(data.outcome), agent_id = tostring(data.agent_id),
        change = tostring(data.change), metadata_status = tostring(data.metadata_status)
);
let Valid = materialize(
    Raw
    | where schema_version == 1 and isnotempty(event_id) and isnotnull(occurred_at)
    | where event_name in ("heartbeat", "login", "activity", "agent_publish")
    | summarize arg_max(TimeGenerated, *) by event_id
);
let Heartbeats = Valid
    | where event_name == "heartbeat"
    | summarize first_heartbeat_utc = min(occurred_at), last_heartbeat_utc = max(occurred_at);
let Events = materialize(
    Valid
    | where occurred_at >= _WindowStart and occurred_at < _WindowEnd
    | where event_name != "heartbeat"
    | where _TrafficType == "all" or traffic_type == _TrafficType
);
let Created = materialize(
    Events
    | where event_name == "agent_publish" and outcome == "success" and change == "created"
    | where isnotempty(agent_id) and isnotempty(user_id)
    | summarize arg_min(occurred_at, *) by agent_id
);
let Active = Events | where isnotempty(user_id);
let UserDays = Active
    | summarize login_successes = countif(event_name == "login" and outcome == "success")
        by day = startofday(occurred_at), user_id;
let Summary = Events
    | summarize
        login_successes = countif(event_name == "login" and outcome == "success"),
        login_failures = countif(event_name == "login" and outcome == "failure"),
        successful_publications = countif(event_name == "agent_publish" and outcome == "success"),
        failed_publications = countif(event_name == "agent_publish" and outcome == "failure"),
        later_version_publications = countif(event_name == "agent_publish"
            and outcome == "success" and change == "version_published"),
        unknown_publication_metadata = countif(event_name == "agent_publish"
            and outcome == "success" and metadata_status != "complete")
    | extend
        active_users = toscalar(Active | distinct user_id | count),
        signed_in_users = toscalar(Events
            | where event_name == "login" and outcome == "success" and isnotempty(user_id)
            | distinct user_id | count),
        created_agents = toscalar(Created | count),
        agent_creators = toscalar(Created | distinct user_id | count);
let Daily = Events
    | summarize
        login_successes = countif(event_name == "login" and outcome == "success"),
        login_failures = countif(event_name == "login" and outcome == "failure"),
        successful_publications = countif(event_name == "agent_publish" and outcome == "success"),
        failed_publications = countif(event_name == "agent_publish" and outcome == "failure")
        by day = startofday(occurred_at)
    | join kind=leftouter (
        UserDays | summarize active_users = count(),
            signed_in_users = countif(login_successes > 0) by day
    ) on day
    | join kind=leftouter (
        Created | summarize created_agents = count() by day = startofday(occurred_at)
    ) on day
    | project day, login_successes, login_failures, successful_publications,
        failed_publications, active_users = coalesce(active_users, 0),
        signed_in_users = coalesce(signed_in_users, 0),
        created_agents = coalesce(created_agents, 0)
    | order by day asc;
let Creators = Created
    | summarize created_agents = count() by user_id
    | join kind=leftouter (
        Events
        | where event_name == "agent_publish"
        | summarize successful_publications = countif(outcome == "success"),
            failed_publications = countif(outcome == "failure") by user_id
    ) on user_id
    | project user_id, created_agents, successful_publications, failed_publications
    | top 20 by created_agents desc;
print
    window_start_utc = _WindowStart, window_end_utc = _WindowEnd,
    queried_at_utc = _QueryNow, traffic_type = _TrafficType,
    first_heartbeat_utc = toscalar(Heartbeats | project first_heartbeat_utc),
    last_heartbeat_utc = toscalar(Heartbeats | project last_heartbeat_utc),
    latest_event_utc = toscalar(Events | summarize max(occurred_at)),
    latest_ingestion_utc = toscalar(Valid | summarize max(ingested_at)),
    malformed_records = toscalar(Raw | where isnull(schema_version)
        or isempty(event_id) or isnull(occurred_at) | count),
    unsupported_schema_records = toscalar(Raw
        | where isnotnull(schema_version) and schema_version != 1 | count),
    summary = toscalar(Summary | project pack_all()),
    daily = toscalar(Daily | summarize make_list(pack_all(), 31)),
    creators = toscalar(Creators | summarize make_list(pack_all(), 20))
